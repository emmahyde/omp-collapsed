{
  "name": "omp-collapsed",
  "version": "1.0.0",
  "description": "Compacted tool-result views for Oh My Pi: tool cards, tool rows, and AST outlines.",
  "type": "module",
  "main": "./index.ts",
  "bin": "./install.sh",
  "scripts": {
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@toon-format/toon": "4.1.1",
    "yaml": "2.8.3"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-natives": "*",
    "@oh-my-pi/pi-tui": "*",
    "@oh-my-pi/pi-utils": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-natives": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-utils": {
      "optional": true
    }
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.13.2",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
